# Client Environment Variables (Public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Supabase Edge Function Secrets (Do NOT expose on client!)
# Configure these in Supabase Dashboard -> Edge Functions -> Secrets
#
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-1.5-flash
# ALLOWED_ORIGINS=https://should-i-go-for-that.vercel.app,http://localhost:5173
